# ─────────────────────────────────────────────────────────────────────────────
# NEXORA environment configuration (Stellar Mainnet)
#
# Enter these in your host's dashboard (Vercel: Project → Settings → Environment
# Variables; Netlify: Site configuration → Environment variables) or, when
# self-hosting, in a git-ignored `.env.production`.
#
# Every variable is read SERVER-SIDE at runtime. None is exposed to the browser.
# There are no NEXT_PUBLIC_ variables. Wallet secret keys exist only in users'
# browsers; never put a Stellar secret key (S…) in any variable.
#
# Diagnostics: GET /api/health?deep=1 reports, as booleans only, whether Horizon
# is reachable on Mainnet, whether the Soroban RPC is configured and verified,
# and whether optional provider keys are present.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ Stellar network ═════════════════════════════════════════════════════════

# STELLAR_HORIZON_URL — OPTIONAL · not secret (unless your provider embeds a key)
# Mainnet Horizon base URL (https). Used for balances, asset search, order books,
# trades, swap quotes, fees, vouchers (claimable balances), submission, receipts.
# Default: https://horizon.stellar.org (SDF public Horizon; rate-limited per IP,
# and all NEXORA users share your server's IP). For production traffic get a
# provider endpoint: https://developers.stellar.org/docs/data/apis/horizon/providers
STELLAR_HORIZON_URL=

# STELLAR_MAINNET_SOROBAN_RPC_URL — REQUIRED for smart-contract features · SECRET if it contains a key
# Mainnet Soroban RPC endpoint (https) from a provider you choose:
# https://developers.stellar.org/docs/data/rpc/providers (SDF runs no public Mainnet RPC).
# Needed by: Blend lending (markets, positions, supply/withdraw/borrow/repay),
# DeFindex vaults (position, deposit, withdraw, contract checks), Soroban token
# deployment (Launchpad). Without it these show "temporarily unavailable"; all
# other features work. Verified at runtime (Mainnet passphrase + healthy); no fallback.
STELLAR_MAINNET_SOROBAN_RPC_URL=

# ═══ Optional data providers ═════════════════════════════════════════════════

# STELLAR_EXPERT_API_KEY — OPTIONAL · SECRET
# From StellarExpert (stellar.expert). Enables Mainnet movers/new-asset discovery
# on Explore. Without it Explore uses the free StellarExpert Top-50 list.
STELLAR_EXPERT_API_KEY=

# DEFINDEX_API_KEY — OPTIONAL · SECRET
# From DeFindex (defindex.io). Enables detailed vault metadata (APY, fees, roles)
# in the vault drawer. Deposits/withdrawals do NOT need it (they call the vault
# contracts directly via the Soroban RPC).
DEFINDEX_API_KEY=

# ═══ Regional access (owner/legal decision) ══════════════════════════════════

# RESTRICTED_COUNTRIES — OPTIONAL · not secret
# Comma-separated ISO 3166-1 alpha-2 codes (e.g. "AA,BB"). Visitors from these
# countries see a "Not available in your region" page and transaction APIs return
# HTTP 451; legal pages stay reachable. Empty = no regional restriction.
# NEXORA assumes no jurisdictions: decide this list with legal counsel.
RESTRICTED_COUNTRIES=

# GEO_COUNTRY_HEADER — OPTIONAL · not secret
# Request header carrying the visitor's country, set by YOUR edge/proxy. Leave
# empty on Vercel (uses x-vercel-ip-country) and Netlify (uses x-country). For
# self-hosting behind e.g. Cloudflare use "cf-ipcountry". Never point this at a
# header that clients can set themselves.
GEO_COUNTRY_HEADER=

# TRUSTED_CLIENT_IP_HEADER — OPTIONAL · not secret
# Header holding the real client IP for rate limiting. Leave empty on Vercel and
# Netlify (handled automatically) and behind standard reverse proxies
# (x-forwarded-for). Example for Cloudflare: "cf-connecting-ip".
TRUSTED_CLIENT_IP_HEADER=

# ═══ Legal documents (owner/legal decision) ══════════════════════════════════
# Used by /terms, /privacy, /risk-disclosure, /wallet-security, /restricted-regions.
# Unset values are omitted from the documents (nothing is assumed).

# LEGAL_OPERATOR_NAME — OPTIONAL · e.g. the legal entity that operates the site.
LEGAL_OPERATOR_NAME=
# LEGAL_CONTACT_EMAIL — OPTIONAL · public contact address for legal/privacy questions.
LEGAL_CONTACT_EMAIL=
# LEGAL_GOVERNING_LAW — OPTIONAL · e.g. "the laws of <jurisdiction>" (counsel to decide).
LEGAL_GOVERNING_LAW=
# LEGAL_EFFECTIVE_DATE — OPTIONAL · ISO date shown as the documents' effective date.
LEGAL_EFFECTIVE_DATE=
# LEGAL_DOCS_APPROVED — OPTIONAL · set to "true" only after qualified counsel has
# reviewed the documents; until then they show "Draft pending legal review".
LEGAL_DOCS_APPROVED=

# ═══ Accounts, RWA programme and admin portal ════════════════════════════════
# Needed for: NEXORA accounts, RWA applications/documents/review, offerings and
# subscriptions, and the private admin portal. Without DATABASE_URL these features
# show "not available on this deployment"; every wallet/trading feature still works.
# Setup steps: NEXORA-FINAL-DEPLOYMENT-GUIDE.md §3a–3c.

# DATABASE_URL — REQUIRED for accounts/RWA/admin · SECRET
# PostgreSQL 15+ connection string. Supabase: Project → Connect → "Transaction pooler"
# URI (port 6543) with your database password. Used only on the server. Never use the
# Supabase anon/service keys here and never expose this to the browser.
# Apply the schema once (and after upgrades): DATABASE_URL=... npm run db:migrate
DATABASE_URL=

# DATABASE_POOL_MAX — OPTIONAL · connections per server instance (default 5).
DATABASE_POOL_MAX=

# DATA_ENCRYPTION_KEY — REQUIRED for accounts/RWA/admin · SECRET
# 32 random bytes, base64. Encrypts uploaded documents and admin MFA secrets at rest.
# Generate: openssl rand -base64 32   Keep a secure offline copy: losing it makes
# stored documents and MFA enrolments unreadable. Don't change it after go-live.
DATA_ENCRYPTION_KEY=

# ADMIN_HOST — REQUIRED for the admin portal · not secret
# Hostname that serves the private portal, e.g. admin.nexora.com (add it as a domain
# of the same project). Everywhere else /admin and /api/admin return 404. Unset = no portal.
ADMIN_HOST=

# NEXORA_ADMIN_EMAIL — REQUIRED for the admin portal · PRIVATE (server-only)
# The founder's email. Only this address can complete the one-time administrator setup
# and sign in as Super Admin. Never shown in the browser. Changing it later does NOT
# transfer access: use `npm run admin:recovery -- change-email` first (see the guide).
NEXORA_ADMIN_EMAIL=

# RESEND_API_KEY + EMAIL_FROM — REQUIRED for account and admin email verification · SECRET (key)
# Transactional email via Resend (resend.com). EMAIL_FROM must be an address on a
# domain you verified in Resend, e.g. "NEXORA <no-reply@nexora.com>".
RESEND_API_KEY=
EMAIL_FROM=

# EMAIL_TEST_OUTBOX — LOCAL AUTOMATED TESTS ONLY. "true" stores emails in the database
# instead of sending them. Ignored on Vercel and Netlify. Never set it in production.
EMAIL_TEST_OUTBOX=

# ═══ Security headers ════════════════════════════════════════════════════════

# HSTS_PRELOAD — OPTIONAL · "true" only if you will submit the domain to the HSTS
# preload list (forces HTTPS for the domain and ALL subdomains, long-term).
HSTS_PRELOAD=

# ═══ Set automatically — do not configure ═══════════════════════════════════
# VERCEL / NETLIFY            set by the platform (used to pick trusted headers)
# NODE_ENV                    set by Next.js
# NEXT_OUTPUT=standalone      set by the Dockerfile for container builds
# PORT                        set by most hosts (default 3000)
